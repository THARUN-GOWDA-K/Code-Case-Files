# backend/.env.example
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and should NEVER be committed.

# MySQL connection string (used by SQLAlchemy)
# For local dev without Docker: install MySQL locally and match these credentials.
# For Docker Compose: the db service already sets these; no .env needed inside containers.
DATABASE_URL=mysql+pymysql://codecase:codecase@localhost:3306/codecase

# If you want to use SQLite instead (zero-setup local dev), comment out the line above
# and uncomment the line below:
# DATABASE_URL=sqlite:///./dev.db

# Celery / Redis (only needed if running the grading worker locally)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT signing key — change this to a long random string in production
SECRET_KEY=dev-secret-change-me
